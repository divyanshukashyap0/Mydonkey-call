{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mydonkey-call.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://mydonkey-call.onrender.com/socket.io/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
